<mxfile host="app.diagrams.net" agent="C4 Diagram Skill" version="24.0.0" type="device">
  <diagram id="c4-container" name="C4 Container Diagram - ISC Config Hub">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ======================================== -->
        <!-- LAYER 1: Person                          -->
        <!-- ======================================== -->

        <mxCell id="person_1"
          value=""
          style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="20" width="40" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="person_1_label"
          value="&lt;b&gt;DevOps / Platform Engineer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Onboards new ISC tenants for daily backups.&lt;/font&gt;"
          style="text;html=1;fontSize=12;align=center;verticalAlign=top;"
          vertex="1" parent="1">
          <mxGeometry x="570" y="85" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- ======================================== -->
        <!-- LAYER 2: System Boundary                 -->
        <!-- ======================================== -->

        <mxCell id="boundary_1"
          value="ISC Config Hub CI/CD [Software System]"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;fontColor=#444444;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="1480" height="480" as="geometry"/>
        </mxCell>

        <!-- Row 1: Workflows -->
        <mxCell id="container_onboarding"
          value="&lt;b&gt;Onboarding Workflow&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: GitHub Actions]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Validates credentials, creates tenant branch + env + secrets, registers in manifest.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=13;align=center;"
          vertex="1" parent="boundary_1">
          <mxGeometry x="80" y="50" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="container_backup"
          value="&lt;b&gt;Backup Workflow&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: GitHub Actions, per branch]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Daily cron-triggered ISC configuration snapshot. Staggers by onboarding time.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=13;align=center;"
          vertex="1" parent="boundary_1">
          <mxGeometry x="420" y="50" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="container_restore"
          value="&lt;b&gt;Restore Workflow&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: GitHub Actions, per branch]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Restores configuration snapshots to ISC tenant via Config Hub API.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=13;align=center;"
          vertex="1" parent="boundary_1">
          <mxGeometry x="760" y="50" width="240" height="120" as="geometry"/>
        </mxCell>

        <!-- Row 2: Storage -->
        <mxCell id="db_manifest"
          value="&lt;b&gt;tenants.json&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: JSON manifest on main]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Single source of truth for all onboarded tenants and their backup schedules.&lt;/font&gt;"
          style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=13;align=center;"
          vertex="1" parent="boundary_1">
          <mxGeometry x="80" y="250" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="container_envs"
